# ============================================================
# Pandly .gitignore
# ============================================================

# ---- Dependencies ----
node_modules/

# ---- Next.js build output ----
.next/
out/
build/
dist/
next-env.d.ts
tsconfig.tsbuildinfo

# ---- Environment ----
.env
.env.*
!.env.example

# ---- Logs & OS temp ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.DS_Store
Thumbs.db
*.swp
*.tmp

# ---- C/C++ build artifacts (Emscripten) ----
*.o
*.obj
*.a
*.so
*.dll
*.dylib
*.wasm.map
*.js.map

# ---- Editor / IDE ----
.vscode/*
!.vscode/extensions.json
.idea/
*.iml

# ---- Nested Flutter source repo (own .git) — excluded to keep this repo clean ----
/Pandly_Frontend/

# ---- Uploads / misc ----
/public/wasm/liquid_engine.worker.js
